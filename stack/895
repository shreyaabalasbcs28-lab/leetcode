class FreqStack {
private:
    unordered_map<int, int> freq;               
    unordered_map<int, stack<int>> group;       
    int maxFreq = 0;                           

public:
    FreqStack() {}
    void push(int val) {
        freq[val]++;
        int current_freq = freq[val];
        maxFreq = max(maxFreq, current_freq);
        group[current_freq].push(val);
    }
    int pop() {
        int val = group[maxFreq].top();
        group[maxFreq].pop();
        freq[val]--;
        if (group[maxFreq].empty()) {
            maxFreq--;
        }
        return val;
    }
};
